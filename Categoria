<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mapa de Categorias — Mercado Livre</title>
<link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --yellow:#FFE600;
  --dark:#12121F;
  --ink:#26263A;
  --muted:#767689;
  --bg:#F7F6F1;
  --card:#FFFFFF;
  --line:#E7E4D8;

  --g-tech:#2968C8;   --g-tech-bg:#EAF1FC;
  --g-casa:#1E9E6B;   --g-casa-bg:#E7F8F0;
  --g-moda:#D6336C;   --g-moda-bg:#FCEAF1;
  --g-veic:#E8590C;   --g-veic-bg:#FDEEE3;
  --g-lazer:#7048E8;  --g-lazer-bg:#F1ECFD;
  --g-outros:#495057; --g-outros-bg:#EEEFF1;
}
*{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:'Inter',sans-serif;
}
h1,h2,h3,.brand,.cat-title,.group-title{font-family:'Space Grotesk',sans-serif;}
::selection{background:var(--yellow);}

/* ===== TOPBAR ===== */
.topbar{
  position:sticky; top:0; z-index:40;
  background:var(--dark);
  color:#fff;
  padding:10px 0;
  border-bottom:3px solid var(--yellow);
}
.topbar .brand{font-weight:700; font-size:1.05rem; display:flex; align-items:center; gap:8px;}
.topbar .brand i{color:var(--yellow);}
.topbar .toolbar-btn{
  background:transparent;
  border:1px solid rgba(255,255,255,.2);
  color:#e8e8ee;
  font-size:.78rem;
  padding:5px 12px;
  border-radius:8px;
  transition:.15s;
}
.topbar .toolbar-btn:hover{border-color:var(--yellow); color:var(--yellow);}

/* ===== HERO ===== */
.hero{
  background:var(--dark);
  color:#fff;
  padding:46px 0 84px;
  position:relative;
  overflow:hidden;
}
.hero-grid{
  position:absolute; inset:0;
  background-image:
    linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
  background-size:42px 42px;
  mask-image:radial-gradient(ellipse at top right, black, transparent 70%);
}
.hero::after{
  content:""; position:absolute; right:-140px; top:-160px;
  width:460px; height:460px; background:var(--yellow); border-radius:50%; opacity:.10;
}
.hero .eyebrow{
  letter-spacing:.14em; text-transform:uppercase; font-size:.72rem;
  color:var(--yellow); font-weight:700;
}
.hero h1{font-size:clamp(1.9rem,3.6vw,2.9rem); font-weight:700; line-height:1.08; margin:.5rem 0 1rem;}
.hero p.lead{color:#c6c6d4; max-width:600px; font-size:1rem;}
.stat-row{margin-top:1.75rem; position:relative; z-index:2;}
.stat{border-left:2px solid rgba(255,230,0,.55); padding-left:12px;}
.stat .num{font-family:'Space Grotesk',sans-serif; font-size:1.6rem; font-weight:700; color:var(--yellow); line-height:1;}
.stat .lbl{font-size:.72rem; color:#9d9dad; text-transform:uppercase; letter-spacing:.05em;}

/* ===== SEARCH ===== */
.search-wrap{margin-top:-40px; position:relative; z-index:10;}
.search-card{
  background:var(--card); border:1px solid var(--line); border-radius:16px;
  box-shadow:0 20px 44px -20px rgba(18,18,31,.28); padding:16px 20px;
}
#searchInput{border:none; outline:none; font-size:1rem; width:100%; background:transparent;}
#resultCount{font-size:.78rem; color:var(--muted); white-space:nowrap;}
.group-filters{display:flex; flex-wrap:wrap; gap:8px; margin-top:14px;}
.gf-btn{
  border:1px solid var(--line); background:#fff; border-radius:999px;
  padding:5px 13px; font-size:.76rem; font-weight:600; color:var(--ink);
  display:inline-flex; align-items:center; gap:6px; cursor:pointer; transition:.15s;
}
.gf-btn .dot{width:8px;height:8px;border-radius:50%;}
.gf-btn.active{border-color:transparent; color:#fff;}
.gf-btn.active .dot{background:#fff !important;}

/* ===== LAYOUT ===== */
.layout{display:grid; grid-template-columns:250px 1fr; gap:28px; align-items:start; margin-top:26px;}
@media (max-width:991px){.layout{grid-template-columns:1fr;}}

/* SIDEBAR */
.sidebar{position:sticky; top:70px; max-height:calc(100vh - 90px); overflow-y:auto; padding-right:6px;}
.sidebar::-webkit-scrollbar{width:5px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--line); border-radius:6px;}
.sb-group{margin-bottom:4px;}
.sb-group-head{
  display:flex; align-items:center; gap:8px;
  padding:8px 10px; border-radius:10px; font-size:.8rem; font-weight:700;
  color:var(--ink); cursor:default;
}
.sb-group-head .dot{width:9px;height:9px;border-radius:50%;flex:0 0 auto;}
.sb-cat-link{
  display:block; padding:6px 10px 6px 27px; font-size:.79rem; color:var(--muted);
  text-decoration:none; border-radius:8px; border-left:2px solid transparent;
  transition:.12s;
}
.sb-cat-link:hover{color:var(--ink); background:#fff;}
.sb-cat-link.active{color:var(--ink); font-weight:600; background:#fff; border-left-color:var(--yellow);}

/* MAIN */
.group-section{margin-bottom:14px; scroll-margin-top:70px;}
.group-banner{
  display:flex; align-items:center; gap:10px;
  padding:12px 16px; border-radius:14px; margin-bottom:14px;
}
.group-banner i{font-size:1.15rem;}
.group-title{font-size:1rem; font-weight:700; margin:0;}
.group-sub{font-size:.76rem; opacity:.75; margin:0;}

.cat-card{
  background:var(--card); border:1px solid var(--line); border-radius:16px;
  margin-bottom:14px; overflow:hidden; scroll-margin-top:70px;
}
.cat-header{
  display:flex; align-items:center; gap:14px; padding:16px 18px; cursor:pointer; user-select:none;
}
.cat-icon{
  width:42px; height:42px; flex:0 0 42px; border-radius:11px;
  display:flex; align-items:center; justify-content:center; font-size:1.15rem;
}
.cat-title{font-size:1rem; font-weight:700; margin:0;}
.cat-meta{font-size:.74rem; color:var(--muted);}
.cat-id{font-size:.66rem; color:var(--muted); background:#F3F1E8; border-radius:6px; padding:1px 7px; font-family:monospace;}
.chevron{margin-left:auto; transition:transform .25s; color:var(--muted);}
.cat-header[aria-expanded="true"] .chevron{transform:rotate(180deg);}

.subcats{padding:0 18px 18px; display:grid; grid-template-columns:repeat(auto-fill,minmax(270px,1fr)); gap:10px;}
.subcats.list-view{grid-template-columns:1fr;}
.sub-card{border:1px solid var(--line); border-radius:12px; padding:13px 15px; background:#FCFCF9; transition:.15s;}
.sub-card:hover{box-shadow:0 8px 20px -12px rgba(18,18,31,.25);}
.sub-card h4{font-size:.87rem; font-weight:700; margin-bottom:3px; color:var(--dark);}
.sub-card p{font-size:.78rem; color:#5c5c6b; margin:0 0 8px; line-height:1.4;}
.leaf-tags{display:flex; flex-wrap:wrap; gap:5px;}
.leaf-tag{
  font-size:.68rem; padding:2px 8px; border-radius:999px; background:#fff;
  border:1px solid var(--line); color:var(--muted);
}
mark{background:var(--yellow); padding:0 2px; border-radius:2px;}
.hidden{display:none !important;}

footer{padding:38px 0 60px; color:var(--muted); font-size:.83rem;}
footer a{color:var(--g-tech);}
footer code{background:#efeee6; padding:1px 5px; border-radius:5px;}

.back-top{
  position:fixed; bottom:22px; right:22px; width:44px; height:44px; border-radius:50%;
  background:var(--dark); color:var(--yellow); display:flex; align-items:center; justify-content:center;
  box-shadow:0 10px 24px -8px rgba(0,0,0,.4); text-decoration:none; opacity:0; pointer-events:none; transition:.2s; z-index:30;
}
.back-top.show{opacity:1; pointer-events:auto;}

@media (max-width:576px){
  .hero{padding:36px 0 64px;}
  .subcats{grid-template-columns:1fr;}
}
</style>
</head>
