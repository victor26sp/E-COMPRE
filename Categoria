/* ===================== HELPERS ===================== */
function slug(s){return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-');}
function groupOf(id){return GROUPS.find(g=>g.id===id);}

/* stats */
let totalSubs=0, totalLeaves=0;
DATA.forEach(c=>{totalSubs+=c.subs.length; c.subs.forEach(s=>totalLeaves+=s.leaves.length);});
document.getElementById('statCats').textContent = DATA.length;
document.getElementById('statSubs').textContent = totalSubs;
document.getElementById('statLeaves').textContent = totalLeaves+'+';

/* ===================== RENDER: GROUP FILTERS ===================== */
const groupFilters = document.getElementById('groupFilters');
let activeGroup = 'all';
function renderGroupFilters(){
  const allBtn = `<button class="gf-btn active" data-g="all" style="border-color:var(--dark);background:var(--dark);color:#fff;"><span class="dot" style="background:var(--yellow)"></span>Todas</button>`;
  const btns = GROUPS.map(g=>`<button class="gf-btn" data-g="${g.id}"><span class="dot" style="background:${g.color}"></span>${g.name}</button>`).join('');
  groupFilters.innerHTML = allBtn + btns;
  groupFilters.querySelectorAll('.gf-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      activeGroup = btn.dataset.g;
      groupFilters.querySelectorAll('.gf-btn').forEach(b=>{
        b.classList.remove('active');
        b.style.background=''; b.style.borderColor=''; b.style.color='';
      });
      btn.classList.add('active');
      if(btn.dataset.g==='all'){btn.style.background='var(--dark)'; btn.style.color='#fff'; btn.style.borderColor='var(--dark)';}
      else{const g=groupOf(btn.dataset.g); btn.style.background=g.color; btn.style.color='#fff'; btn.style.borderColor=g.color;}
      applyFilters();
    });
  });
}
renderGroupFilters();

/* ===================== RENDER: SIDEBAR + MAIN ===================== */
const sidebar = document.getElementById('sidebar');
const mainContent = document.getElementById('mainContent');

function render(){
  let sbHtml = '';
  let mainHtml = '';

  GROUPS.forEach(g=>{
    const cats = DATA.filter(c=>c.group===g.id);
    if(cats.length===0) return;

    sbHtml += `<div class="sb-group">
      <div class="sb-group-head"><span class="dot" style="background:${g.color}"></span>${g.name}</div>
      ${cats.map(c=>`<a class="sb-cat-link" href="#${slug(c.name)}" data-cat="${slug(c.name)}"><i class="bi ${c.icon} me-1"></i>${c.name}</a>`).join('')}
    </div>`;

    mainHtml += `<section class="group-section" id="section-${g.id}" data-group="${g.id}">
      <div class="group-banner" style="background:${g.bg};">
        <i class="bi ${g.icon}" style="color:${g.color}"></i>
        <div>
          <p class="group-title" style="color:${g.color}">${g.name}</p>
          <p class="group-sub">${cats.length} categorias · ${cats.reduce((a,c)=>a+c.subs.length,0)} subcategorias</p>
        </div>
      </div>
      ${cats.map(c=>renderCatCard(c,g)).join('')}
    </section>`;
  });

  sidebar.innerHTML = sbHtml;
  mainContent.innerHTML = mainHtml;

  document.querySelectorAll('.cat-header').forEach(h=>{
    h.addEventListener('click',()=>{
      const body = document.getElementById(h.dataset.target);
      const expanded = h.getAttribute('aria-expanded')==='true';
      h.setAttribute('aria-expanded', String(!expanded));
      body.classList.toggle('hidden');
    });
  });
}

function renderCatCard(c,g){
  const cid = slug(c.name);
  return `<div class="cat-card" id="${cid}" data-cat-index="${DATA.indexOf(c)}" data-group="${g.id}">
    <div class="cat-header" role="button" aria-expanded="false" data-target="body-${cid}">
      <div class="cat-icon" style="background:${g.bg};color:${g.color};"><i class="bi ${c.icon}"></i></div>
      <div>
        <p class="cat-title">${c.name}</p>
        <span class="cat-meta">${c.subs.length} subcategorias &nbsp;·&nbsp; <span class="cat-id">${c.id}</span></span>
      </div>
      <i class="bi bi-chevron-down chevron"></i>
    </div>
    <div class="subcats hidden" id="body-${cid}">
      ${c.subs.map(s=>`
        <div class="sub-card" data-search="${(s.name+' '+s.desc+' '+s.leaves.join(' ')).toLowerCase()}">
          <h4>${s.name}</h4>
          <p>${s.desc}</p>
          <div class="leaf-tags">${s.leaves.map(l=>`<span class="leaf-tag">${l}</span>`).join('')}</div>
        </div>
      `).join('')}
    </div>
  </div>`;
}
render();

/* ===================== SEARCH + GROUP FILTER ===================== */
const input = document.getElementById('searchInput');
const noResults = document.getElementById('noResults');
const resultCount = document.getElementById('resultCount');

function applyFilters(){
  const q = input.value.trim().toLowerCase();
  let visibleCats=0, visibleSubs=0;

  document.querySelectorAll('.group-section').forEach(sec=>{
    const groupMatches = activeGroup==='all' || sec.dataset.group===activeGroup;
    let anyCatVisibleInGroup=false;

    sec.querySelectorAll('.cat-card').forEach(card=>{
      const ci = card.dataset.catIndex;
      const catData = DATA[ci];
      const header = card.querySelector('.cat-header');
      const body = document.getElementById(header.dataset.target);
      const catNameMatch = q==='' ? true : catData.name.toLowerCase().includes(q);
      let anySubVisible=false;

      card.querySelectorAll('.sub-card').forEach(sc=>{
        const match = q==='' || sc.dataset.search.includes(q) || catNameMatch;
        sc.classList.toggle('hidden', !match);
        if(match){anySubVisible=true; visibleSubs++;}
      });

      const showCard = groupMatches && (q==='' ? true : (catNameMatch || anySubVisible));
      card.classList.toggle('hidden', !showCard);
      if(showCard){visibleCats++; anyCatVisibleInGroup=true;}

      if(q!=='' && showCard){
        header.setAttribute('aria-expanded','true');
        body.classList.remove('hidden');
      } else if(q===''){
        header.setAttribute('aria-expanded','false');
        body.classList.add('hidden');
      }
    });

    sec.classList.toggle('hidden', !(groupMatches && anyCatVisibleInGroup));
  });

  noResults.classList.toggle('hidden', visibleCats!==0);
  resultCount.textContent = (q==='' && activeGroup==='all') ? '' : `${visibleCats} categorias · ${visibleSubs} subcategorias`;
}
input.addEventListener('input', applyFilters);

/* ===================== EXPAND / COLLAPSE / VIEW TOGGLE ===================== */
document.getElementById('expandAllBtn').addEventListener('click',()=>{
  document.querySelectorAll('.cat-header').forEach(h=>{
    h.setAttribute('aria-expanded','true');
    document.getElementById(h.dataset.target).classList.remove('hidden');
  });
});
document.getElementById('collapseAllBtn').addEventListener('click',()=>{
  document.querySelectorAll('.cat-header').forEach(h=>{
    h.setAttribute('aria-expanded','false');
    document.getElementById(h.dataset.target).classList.add('hidden');
  });
});
let listView=false;
document.getElementById('viewToggleBtn').addEventListener('click',(e)=>{
  listView=!listView;
  document.querySelectorAll('.subcats').forEach(el=>el.classList.toggle('list-view',listView));
  document.getElementById('viewToggleLabel').textContent = listView ? 'Ver em grade' : 'Ver em lista';
  e.currentTarget.querySelector('i').className = listView ? 'bi bi-grid-3x3-gap' : 'bi bi-list-ul';
});

/* ===================== SCROLLSPY ===================== */
const sbLinks = () => document.querySelectorAll('.sb-cat-link');
const observer = new IntersectionObserver((entries)=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){
      const id = entry.target.id;
      sbLinks().forEach(l=>l.classList.toggle('active', l.dataset.cat===id));
    }
  });
},{rootMargin:"-15% 0px -70% 0px"});
document.querySelectorAll('.cat-card').forEach(c=>observer.observe(c));

/* ===================== BACK TO TOP ===================== */
const backTop = document.getElementById('backTop');
window.addEventListener('scroll',()=>{backTop.classList.toggle('show', window.scrollY>500);});
</script>
