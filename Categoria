      <div class="col-4 col-md-2"><div class="stat"><div class="num" id="statCats">–</div><div class="lbl">Categorias</div></div></div>
      <div class="col-4 col-md-2"><div class="stat"><div class="num" id="statSubs">–</div><div class="lbl">Subcategorias</div></div></div>
